[Unit]
Description=MAVProxy Boot Telemetry Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=GCS_HOST=127.0.0.1
ExecStart=/usr/bin/mavproxy.py --master=/dev/ttyTHS1 --baud=57600 --out=udp:${GCS_HOST}:14550 --daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

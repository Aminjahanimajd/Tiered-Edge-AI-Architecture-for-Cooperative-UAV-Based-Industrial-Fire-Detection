<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_v2_sentinel_proxy">
    <include merge="true">
      <uri>x500</uri>
    </include>
    <link name="sentinel_identity_link">
      <pose relative_to="base_link">0 0 0.16 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <visual name="sentinel_orange_longitudinal_marker">
        <geometry><box><size>1.10 0.14 0.055</size></box></geometry>
        <material>
          <ambient>1 0.25 0.02 1</ambient>
          <diffuse>1 0.25 0.02 1</diffuse>
          <emissive>0.8 0.12 0.01 1</emissive>
        </material>
      </visual>
      <visual name="sentinel_orange_lateral_marker">
        <geometry><box><size>0.14 1.10 0.055</size></box></geometry>
        <material>
          <ambient>1 0.25 0.02 1</ambient>
          <diffuse>1 0.25 0.02 1</diffuse>
          <emissive>0.8 0.12 0.01 1</emissive>
        </material>
      </visual>
    </link>
    <joint name="sentinel_identity_joint" type="fixed">
      <parent>base_link</parent>
      <child>sentinel_identity_link</child>
    </joint>
  </model>
</sdf>
